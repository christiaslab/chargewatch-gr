# Copy to .env for local development. Real values live in Secret Manager.
# NEVER commit a filled-in .env.

GCP_PROJECT_ID=chargewatch-gr
GCP_REGION=europe-west1
GCS_BUCKET=chargewatch-raw-gr

# Neon — fetch from Secret Manager in deployed environments
DUCKLAKE_CATALOG_URL=postgresql://USER:PASSWORD@HOST/ducklake_catalog?sslmode=require
GOLD_DB_URL=postgresql://USER:PASSWORD@HOST/chargewatch_gold?sslmode=require

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ENTSO-E — request by email to transparency@entsoe.eu, subject "RESTful API access"
ENTSOE_API_TOKEN=
